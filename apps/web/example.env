# Convex
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# App URL. In production, set both this Vercel variable and the Convex SITE_URL
# variable to the same public web origin (for example, https://app.example.com).
# Register <origin>/api/auth/callback/spotify as Spotify's redirect URI.
# For local development, use 127.0.0.1 rather than localhost.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
