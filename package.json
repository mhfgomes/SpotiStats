{
  "name": "spotistats",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @spotistats/web dev",
    "dev:web": "pnpm --filter @spotistats/web dev",
    "dev:mobile": "pnpm --filter @spotistats/mobile dev",
    "build": "pnpm --filter @spotistats/web build",
    "build:ci": "pnpm --filter @spotistats/web build:ci",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  }
}
